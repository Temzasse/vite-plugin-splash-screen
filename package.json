{
  "name": "vite-plugin-splash-screen",
  "version": "0.2.2",
  "description": "Vite plugin for adding a splash screen to your app",
  "keywords": [
    "vite",
    "vite-plugin",
    "splash-screen"
  ],
  "author": "Teemu Taskula",
  "license": "MIT",
  "main": "./dist/plugin/plugin.js",
  "types": "./dist/plugin/plugin.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/plugin/plugin.d.mts",
        "default": "./dist/plugin/plugin.mjs"
      },
      "require": {
        "types": "./dist/plugin/plugin.d.ts",
        "default": "./dist/plugin/plugin.js"
      }
    },
    "./runtime": {
      "import": {
        "types": "./dist/runtime/runtime.d.mts",
        "default": "./dist/runtime/runtime.mjs"
      },
      "require": {
        "types": "./dist/runtime/runtime.d.ts",
        "default": "./dist/runtime/runtime.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "build": "tsdown",
    "build:verify": "attw --pack . --profile node16",
    "watch": "tsdown --watch",
    "format:check": "oxfmt --check ./src ./test ./example/src ./example/vite.config.ts tsdown.config.mts vitest.config.mts",
    "format:write": "oxfmt --write ./src ./test ./example/src ./example/vite.config.ts tsdown.config.mts vitest.config.mts",
    "lint:check": "oxlint --deny-warnings ./src ./test ./example/src ./example/vite.config.ts tsdown.config.mts vitest.config.mts",
    "lint:write": "oxlint --deny-warnings --fix ./src ./test ./example/src ./example/vite.config.ts tsdown.config.mts vitest.config.mts",
    "typecheck": "tsc --noEmit",
    "verify": "run-p format:check lint:check typecheck",
    "release": "npm run verify && npm run build && npm run build:verify && np",
    "example:dev": "npm --prefix example run dev",
    "example:build": "npm --prefix example run build",
    "example:install": "npm --prefix example install",
    "example:deploy": "npm run build && npm --prefix example run build -- --base=/vite-plugin-splash-screen/ && gh-pages --dist example/dist --nojekyll --message \"Deploy example\""
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "gh-pages": "6.3.0",
    "jsdom": "31.0.1",
    "npm-run-all": "4.1.5",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "repository": "https://github.com/Temzasse/vite-plugin-splash-screen",
  "module": "./dist/plugin/plugin.mjs",
  "homepage": "https://temzasse.github.io/vite-plugin-splash-screen/"
}
