{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "node"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "warn",
    "typescript/no-non-null-assertion": "warn",
    "eqeqeq": ["error", "smart"],
    "no-var": "warn",
    "prefer-const": "error"
  },
  "overrides": [
    {
      "files": ["test/**"],
      "rules": { "typescript/no-non-null-assertion": "off" }
    }
  ],
  "ignorePatterns": ["**/dist/**", "**/.yalc/**", "**/node_modules/**"]
}
